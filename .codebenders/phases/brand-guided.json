  "reason": "Ivory and dusty rose surfaces with bronze-gold accents and a soft high-contrast serif give the app the warm, low-glare feel of a lit dressing table, so money screens feel personal rather than corporate.",
  "design_html": "<style>\n@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&display=swap');\n:root {\n  --background: 20.0 37.5% 96.9%;\n  --foreground: 321.8 15.1% 14.3%;\n  --card: 15.0 100.0% 99.2%;\n  --card-foreground: 321.8 15.1% 14.3%;\n  --popover: 15.0 100.0% 99.2%;\n  --popover-foreground: 321.8 15.1% 14.3%;\n  --primary: 315.9 36.8% 26.1%;\n  --primary-foreground: 0 0% 100%;\n  --secondary: 332.2 25.5% 58.4%;\n  --secondary-foreground: 0 0% 100%;\n  --muted: 210 40% 96.1%;\n  --muted-foreground: 326.7 7.8% 45.5%;\n  --accent: 350.9 69.0% 60.8%;\n  --accent-foreground: 0 0% 100%;\n  --destructive: 353.3 53.4% 49.6%;\n  --destructive-foreground: 0 0% 100%;\n  --border: 214.3 31.8% 91.4%;\n  --input: 214.3 31.8% 91.4%;\n  --ring: 315.9 36.8% 26.1%;\n  --radius: 0.5rem;\n  --shadow-sm: 0 1px 2px 0 hsl(var(--foreground) / 0.06);\n  --shadow: 0 4px 12px -2px hsl(var(--foreground) / 0.10);\n  --shadow-lg: 0 12px 32px -8px hsl(var(--foreground) / 0.14);\n}\nhtml,body{margin:0;padding:0;background:hsl(var(--background));color:hsl(var(--foreground));font-family:'DM Sans',ui-sans-serif,system-ui,-apple-system,sans-serif;}\n</style>\n<div class=\"gl\"><style>.gl{background:hsl(var(--background));color:hsl(var(--foreground));line-height:1.5}.gl *{box-sizing:border-box}.gl a{color:inherit;text-decoration:none}.gl .wrap{max-width:72rem;margin:0 auto;padding:0 1.5rem}.gl nav{background:hsl(var(--card));border-bottom:1px solid hsl(var(--border));position:sticky;top:0;z-index:2}.gl nav .wrap{display:flex;align-items:center;justify-content:space-between;height:4rem}.gl .mark{display:flex;align-items:center;gap:.5rem;font-weight:600;font-size:1.0625rem}.gl .mark svg{width:1.25rem;height:1.25rem;color:hsl(var(--primary))}.gl .links{display:flex;gap:1.5rem;font-size:.875rem;color:hsl(var(--muted-foreground))}.gl .navr{display:flex;gap:.5rem;align-items:center}.gl .btn{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;height:2.5rem;padding:0 1rem;border-radius:var(--radius);font-size:.875rem;font-weight:500;border:1px solid transparent;cursor:pointer}.gl .btn-p{background:hsl(var(--primary));color:hsl(var(--primary-foreground))}.gl .btn-o{border-color:hsl(var(--border));background:transparent;color:hsl(var(--foreground))}.gl .hero{padding:5rem 0 3.5rem;text-align:center}.gl .eyebrow{display:inline-block;border-radius:9999px;padding:.25rem .75rem;font-size:.75rem;background:hsl(var(--primary) / 0.1);color:hsl(var(--primary));margin-bottom:1.5rem}.gl h1{font-size:3.25rem;line-height:1.08;letter-spacing:-.02em;margin:0 auto 1.25rem;max-width:48rem;font-weight:600}.gl .lead{font-size:1.125rem;color:hsl(var(--muted-foreground));max-width:36rem;margin:0 auto 2rem}.gl .ctas{display:flex;gap:.75rem;justify-content:center}.gl .sec{padding:3.5rem 0}.gl .sec-h{display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:2rem;gap:2rem}.gl h2{font-size:1.875rem;font-weight:600;margin:0 0 .5rem;letter-spacing:-.01em}.gl h3{font-size:1.0625rem;font-weight:600;margin:.75rem 0 .375rem}.gl .cap{font-size:.8125rem;color:hsl(var(--muted-foreground))}.gl .grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem}.gl .card{background:hsl(var(--card));color:hsl(var(--card-foreground));border:1px solid hsl(var(--border));border-radius:var(--radius);box-shadow:var(--shadow-sm);padding:1.5rem}.gl p{margin:0;font-size:.9375rem;color:hsl(var(--muted-foreground))}.gl .ic{width:2.25rem;height:2.25rem;border-radius:var(--radius);background:hsl(var(--primary) / 0.1);color:hsl(var(--primary));display:flex;align-items:center;justify-content:center}.gl .ic svg{width:1.125rem;height:1.125rem}.gl .dash{display:grid;grid-template-columns:1fr 1.1fr;gap:1.5rem}.gl .row{display:flex;justify-content:space-between;align-items:center;padding:.875rem 0;border-top:1px solid hsl(var(--border));font-size:.9375rem}.gl .row.f{border-top:0;padding-top:0}.gl .amt{font-weight:600;font-variant-numeric:tabular-nums}.gl .over{color:hsl(var(--destructive));font-size:.8125rem}.gl .badge{display:inline-block;border-radius:9999px;padding:.125rem .625rem;font-size:.75rem;background:hsl(var(--secondary));color:hsl(var(--secondary-foreground))}.gl .toggle{display:flex;align-items:center;justify-content:space-between;padding:.75rem 1rem;border:1px solid hsl(var(--border));border-radius:var(--radius);margin-top:1.25rem;font-size:.875rem}.gl .sw{width:2.25rem;height:1.25rem;border-radius:9999px;background:hsl(var(--primary));position:relative}.gl .sw:after{content:\"\";position:absolute;right:.125rem;top:.125rem;width:1rem;height:1rem;border-radius:9999px;background:hsl(var(--primary-foreground))}.gl .alert{display:flex;gap:.75rem;align-items:flex-start;border:1px solid hsl(var(--border));border-radius:var(--radius);padding:1rem;background:hsl(var(--muted));font-size:.875rem}.gl .alert svg{width:1.125rem;height:1.125rem;flex:none;margin-top:.125rem;color:hsl(var(--primary))}.gl .msg{background:hsl(var(--muted));border-radius:calc(var(--radius) - 2px);padding:1rem;font-size:.875rem;margin-top:.75rem;color:hsl(var(--foreground))}.gl .chart{width:100%;height:auto;display:block;margin-top:1rem}.gl .ln{stroke:hsl(var(--primary));fill:none;stroke-width:2}.gl .ln2{stroke:hsl(var(--muted-foreground));fill:none;stroke-width:1.5;stroke-dasharray:4 4}.gl .bar{fill:hsl(var(--primary) / 0.1)}.gl .grd{stroke:hsl(var(--border));stroke-width:1}.gl .stack{display:flex;flex-direction:column;gap:1.5rem}.gl .stat{font-size:1.5rem;font-weight:600;font-variant-numeric:tabular-nums;margin-top:.25rem}.gl footer{border-top:1px solid hsl(var(--border));padding:2rem 0;margin-top:2rem;background:hsl(var(--card))}.gl footer .wrap{display:flex;justify-content:space-between;font-size:.8125rem;color:hsl(var(--muted-foreground));flex-wrap:wrap;gap:1rem}@media(max-width:800px){.gl .grid3,.gl .dash{grid-template-columns:1fr}.gl h1{font-size:2.25rem}.gl .links{display:none}}</style><nav><div class=\"wrap\"><a class=\"mark\" href=\"#\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z\"/></svg>GlowLedger</a><div class=\"links\"><a href=\"#\">Features</a><a href=\"#\">Cash forecast</a><a href=\"#\">Pricing</a><a href=\"#\">Help</a></div><div class=\"navr\"><a class=\"btn btn-o\" href=\"#\">Log in</a><a class=\"btn btn-p\" href=\"#\">Start free</a></div></div></nav><section class=\"hero\"><div class=\"wrap\"><span class=\"eyebrow\">Built for makeup artists and bridal stylists</span><h1>GlowLedger keeps every client balance in view before the big day</h1><p class=\"lead\">Create invoices in three taps, send polite WhatsApp reminders, and see exactly what cash arrives in the next 90 days, with sample data loaded so you can start right away.</p><div class=\"ctas\"><a class=\"btn btn-p\" href=\"#\">Start with sample data</a><a class=\"btn btn-o\" href=\"#\">See how it works</a></div></div></section><section class=\"sec\"><div class=\"wrap\"><div class=\"sec-h\"><div><h2>Everything between the booking and the bank</h2><p>Four tools that replace the notes app, the WhatsApp scroll, and the spreadsheet.</p></div><span class=\"cap\">Works offline on your phone</span></div><div class=\"grid3\"><div class=\"card\"><div class=\"ic\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M6 3h12v18l-3-2-3 2-3-2-3 2z\"/></svg></div><h3>Invoices in 3 taps</h3><p>Enter client name, event date, total fee, and advance paid. Done before the call ends.</p></div><div class=\"card\"><div class=\"ic\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M4 5h16v11H9l-5 4z\"/></svg></div><h3>Polite reminders, ready to send</h3><p>One tap writes a warm WhatsApp reminder with the exact balance. Copy, send, move on.</p></div><div class=\"card\"><div class=\"ic\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M3 17l6-6 4 4 8-8M15 7h6v6\"/></svg></div><h3>30, 60, and 90 day forecast</h3><p>Compare expected client inflows against rent, restocks, and assistant pay.</p></div></div></div></section><section class=\"sec\"><div class=\"wrap\"><div class=\"sec-h\"><div><h2>Who owes me today</h2><p>Overdue balances, exact amounts, and days late, sorted by urgency.</p></div><span class=\"cap\">Updated <code>09:12 today</code></span></div><div class=\"dash\"><div class=\"stack\"><div class=\"card\"><div class=\"row f\"><div><strong>Priya Nair</strong><div class=\"over\">Bridal trial and wedding, 12 days overdue</div></div><span class=\"amt\">$1,240</span></div><div class=\"row\"><div><strong>Ana Lopez</strong><div class=\"over\">Engagement shoot, 4 days overdue</div></div><span class=\"amt\">$680</span></div><div class=\"row\"><div><strong>Jessica Wu</strong><div class=\"over\">Wedding party, 21 days overdue</div></div><span class=\"amt\">$2,150</span></div></div><div class=\"alert\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 7v5l3 2\"/></svg><div><strong>Chase Priya's balance today</strong> to cover next month's studio rent of $1,800.</div></div><div class=\"msg\">Hi Priya, hope the trial looked just right! Friendly reminder that the remaining $1,240 for the wedding is due before 20 June. Thank you so much.</div></div><div class=\"card\"><div class=\"cap\">Expected cash, next 90 days</div><div class=\"stat\">$8,920 net</div><svg class=\"chart\" viewBox=\"0 0 400 180\" preserveAspectRatio=\"none\"><line class=\"grd\" x1=\"0\" y1=\"45\" x2=\"400\" y2=\"45\"/><line class=\"grd\" x1=\"0\" y1=\"90\" x2=\"400\" y2=\"90\"/><line class=\"grd\" x1=\"0\" y1=\"135\" x2=\"400\" y2=\"135\"/><rect class=\"bar\" x=\"20\" y=\"110\" width=\"40\" height=\"70\"/><rect class=\"bar\" x=\"140\" y=\"90\" width=\"40\" height=\"90\"/><rect class=\"bar\" x=\"260\" y=\"70\" width=\"40\" height=\"110\"/><path class=\"ln\" d=\"M0 120 C60 100 100 80 160 85 S260 50 320 45 S380 30 400 25\"/><path class=\"ln2\" d=\"M0 150 L400 110\"/></svg><div class=\"toggle\"><span><strong>What-if:</strong> Jessica pays 15 days late</span><span class=\"sw\" aria-hidden=\"true\"></span></div><div class=\"row\"><span>Cash after Jessica's delay</span><span class=\"amt\">$7,410</span></div></div></div></div></div></section><footer><div class=\"wrap\"><span>© GlowLedger. Made for the makeup chair.</span><span>Privacy · Terms · Support</span></div></footer></div>",
